# KAUSHAL runs with none of these set.
#
# With an empty file it uses a built-in local data store and a deterministic
# on-device scorer, and every screen in the product works end to end. Each
# block below is independent — add the ones you have.

# --- Where this deployment lives ---------------------------------------
# Only needed for a custom domain. On Vercel the production URL is detected,
# and locally it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Supabase ----------------------------------------------------------
# Moves the data from the local store into Postgres, with row level security
# and magic-link auth. See supabase/README.md for the SQL and the bucket.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used by the /demo reset only, to rebuild the seeded academy.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ----------------------------------------------------------------
# Absent keys are not an error. Without GEMINI_API_KEY, scores are derived
# from measurements taken off the pixels in the browser and are labelled as
# measured. Without GROQ_API_KEY, briefs come from the built-in exercise
# library and reports are assembled from the student's own numbers.
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Demo --------------------------------------------------------------
# Guards POST /api/demo/reset in production. Leave blank in development,
# where the reset is open.
DEMO_RESET_TOKEN=
